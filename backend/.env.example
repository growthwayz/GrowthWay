# GrowthWay Backend Environment Configuration Example
# Copy this file to .env and fill in production secrets

# MongoDB URL (MongoDB Atlas or local)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.whxtgfc.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=growthway

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://growthway.in,https://www.growthway.in

# Auth
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-KEY-AT-LEAST-32-CHARS

# Cloudinary
CLOUDINARY_CLOUD_NAME=growthway
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@growthway.in
NOTIFICATION_EMAIL=hello@growthway.in

# WhatsApp notification target
WHATSAPP_NUMBER=+919876543210

# AI (Phase D / Copilot)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Analytics
GA_MEASUREMENT_ID=
