# Copy this template to .env and fill private values. Never commit .env.
ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=growthway
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Bootstrap only creates a missing account or replaces the known legacy demo account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NOTIFICATION_EMAIL=
WHATSAPP_NUMBER=
GA_MEASUREMENT_ID=
SITE_URL=
AI_ENABLED=false
